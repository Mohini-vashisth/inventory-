# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real secrets.

# Required in production (DJANGO_DEBUG=False). In local dev, DEBUG defaults
# to True and SECRET_KEY falls back to an insecure dev-only value if unset.
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=
# Comma-separated. The machine's LAN hostname/IP, e.g. 192.168.1.50 or the
# server's real hostname. Django rejects requests with any other Host header.
DJANGO_ALLOWED_HOSTS=
# Comma-separated, full origin with scheme, e.g. https://quote.mattadrawing.com.
# Only needed for hostnames reached through a reverse proxy (like the
# Cloudflare Tunnel fronting the public quote form) rather than directly —
# required for CSRF checks to pass on form POSTs from that origin.
DJANGO_CSRF_TRUSTED_ORIGINS=

# Shared PIN for the employee portal.
EMPLOYEE_PIN=1234

# SMTP, for sending quote-request emails to customers. Gmail requires an
# App Password (not your account password) — see myaccount.google.com/apppasswords.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
