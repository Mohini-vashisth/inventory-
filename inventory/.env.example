# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real secrets.

# Required in production (DJANGO_DEBUG=False). In local dev, DEBUG defaults
# to True and SECRET_KEY falls back to an insecure dev-only value if unset.
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=
# Comma-separated. The machine's LAN hostname/IP, e.g. 192.168.1.50 or the
# server's real hostname. Django rejects requests with any other Host header.
DJANGO_ALLOWED_HOSTS=
# Comma-separated, full origin with scheme, e.g. https://quote.mattadrawing.com.
# Only needed for hostnames reached through a reverse proxy (like the
# Cloudflare Tunnel fronting the public quote form) rather than directly —
# required for CSRF checks to pass on form POSTs from that origin.
DJANGO_CSRF_TRUSTED_ORIGINS=

# Shared PIN for the employee portal.
EMPLOYEE_PIN=1234

# SMTP, for sending quote-request emails to customers. Gmail requires an
# App Password (not your account password) — see myaccount.google.com/apppasswords.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# Full origin (scheme + host, no trailing slash) that customer-facing quote
# emails should link to, e.g. https://quote.mattadrawing.com. Admins only
# ever browse this app over Tailscale, so without this set, a quote email's
# link would be built from that private address instead — unreachable for
# the customer it's sent to. Leave blank in local dev.
PUBLIC_QUOTE_BASE_URL=

# WhatsApp Business Cloud API webhook (materials/views.py::whatsapp_webhook),
# which turns inbound customer WhatsApp messages into Query records.
# WHATSAPP_VERIFY_TOKEN: any string you choose — enter the same value when
# registering the webhook URL in the Meta App Dashboard (App > WhatsApp >
# Configuration > Webhook). Used only for the one-time GET handshake.
WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET: the Meta App's "App Secret" (App Dashboard > Settings
# > Basic). Verifies the X-Hub-Signature-256 header on every inbound POST —
# this is the only thing authenticating that public endpoint, so guard it
# like DJANGO_SECRET_KEY.
WHATSAPP_APP_SECRET=
# WHATSAPP_ACCESS_TOKEN: a permanent access token for a System User in Meta
# Business Manager (Business Settings > System Users > generate token,
# scoped to whatsapp_business_messaging) — used as the Bearer token for
# every outbound send (the intake template and follow-up questions).
# Guard like any other API secret.
WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID: the numeric ID Meta assigns to the connected
# WhatsApp number (App Dashboard > WhatsApp > API Setup, or Business
# Settings > Accounts > WhatsApp Accounts > phone number details) — not
# the phone number itself.
WHATSAPP_PHONE_NUMBER_ID=

# Printed on the official PDF quotation (materials/pdf.py::generate_quotation_pdf),
# attached to every Send Quote email. Blank defaults are deliberate — an
# incomplete-looking PDF is a visible reminder to fill these in with the
# real business details before this ever goes out to an actual customer.
COMPANY_NAME=Matta Drawing
COMPANY_ADDRESS=
COMPANY_PHONE=
COMPANY_EMAIL=
COMPANY_GST=
COMPANY_WEBSITE=
